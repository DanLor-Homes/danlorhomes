{
  "description": "Cada ma\u00f1ana a las 7:30 escanea las b\u00fasquedas de portales activas y guarda los anuncios nuevos para poder contactar al propietario.",
  "name": "Revisi\u00f3n diaria de portales",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "30 7 * * *",
      "one_time_date": null,
      "timezone": "Europe/Madrid",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "revision_diaria_portales",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "escaneo": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "portalMonitor",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Escanear portales",
            "description": "Anuncios nuevos de captaci\u00f3n"
          }
        }
      }
    ]
  }
}