{
  "name": "Revisi\u00f3n diaria de portales",
  "description": "Cada ma\u00f1ana a las 8:00 escanea las b\u00fasquedas de portales activas, guarda los anuncios nuevos como leads pendientes de revisi\u00f3n y deja constancia de la ejecuci\u00f3n.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 8 * * *",
      "one_time_date": null,
      "timezone": "Europe/Madrid",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "revision_diaria_portales",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "escaneo": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "portalMonitor",
            "args": {}
          },
          "then": "registro_portales",
          "x-base44": {
            "title": "Escanear portales",
            "description": "Anuncios nuevos de captaci\u00f3n"
          }
        }
      },
      {
        "registro_portales": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "logAutomationRun",
            "args": {
              "key": "portales",
              "summary": "Anuncios nuevos: ${ .escaneo.created } de ${ .escaneo.scanned } b\u00fasquedas"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Registrar ejecuci\u00f3n de portales",
            "description": "Guarda fecha y resultado"
          }
        }
      }
    ]
  }
}