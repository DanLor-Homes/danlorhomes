{
  "name": "AutomationRun",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "title": "Automatizaci\u00f3n",
      "enum": [
        "pipeline",
        "seguimiento",
        "portales"
      ],
      "enumColors": [
        "blue",
        "yellow",
        "purple"
      ]
    },
    "run_at": {
      "type": "string",
      "format": "date-time",
      "title": "Ejecutada el"
    },
    "summary": {
      "type": "string",
      "title": "Resumen"
    }
  },
  "required": [
    "key",
    "run_at"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    }
  }
}