{
  "name": "MlsFeed",
  "type": "object",
  "properties": {
    "agency": {
      "type": "string",
      "title": "Agencia"
    },
    "token": {
      "type": "string",
      "title": "Token del feed"
    },
    "active": {
      "type": "boolean",
      "title": "Activo",
      "default": true
    }
  },
  "required": [
    "token"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    }
  }
}