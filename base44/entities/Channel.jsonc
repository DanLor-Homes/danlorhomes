{
  "name": "Channel",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Nombre",
      "enum": [
        "web",
        "referido",
        "linkedin",
        "whatsapp",
        "campana_email",
        "publicidad",
        "portal_inmobiliario",
        "instagram",
        "facebook",
        "google_ads",
        "llamada_fria",
        "cartel"
      ],
      "enumColors": [
        "blue",
        "green",
        "blue",
        "green",
        "purple",
        "yellow",
        "blue",
        "pink",
        "blue",
        "yellow",
        "gray",
        "gray"
      ]
    },
    "active": {
      "type": "boolean",
      "title": "Activo",
      "default": true
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    }
  }
}