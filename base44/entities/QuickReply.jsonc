{
  "name": "QuickReply",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Nombre de la respuesta"
    },
    "body": {
      "type": "string",
      "title": "Texto"
    },
    "active": {
      "type": "boolean",
      "title": "Activa",
      "default": true
    }
  },
  "required": [
    "title",
    "body"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    }
  }
}