{
  "name": "MlsPartner",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Agencia"
    },
    "contact_person": {
      "type": "string",
      "title": "Persona de contacto"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "phone": {
      "type": "string",
      "title": "Tel\u00e9fono"
    },
    "zone": {
      "type": "string",
      "title": "Zona de trabajo"
    },
    "commission_notes": {
      "type": "string",
      "title": "Acuerdo de colaboraci\u00f3n"
    },
    "notes": {
      "type": "string",
      "title": "Notas"
    },
    "active": {
      "type": "boolean",
      "title": "Activa",
      "default": true
    },
    "feed_url": {
      "type": "string",
      "title": "Enlace del feed de la agencia"
    },
    "last_sync_at": {
      "type": "string",
      "format": "date-time",
      "title": "\u00daltima sincronizaci\u00f3n"
    },
    "last_sync_count": {
      "type": "number",
      "title": "Inmuebles sincronizados"
    },
    "last_sync_error": {
      "type": "string",
      "title": "\u00daltimo error"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    }
  }
}