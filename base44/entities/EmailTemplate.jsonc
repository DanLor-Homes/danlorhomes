{
  "name": "EmailTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Nombre de la plantilla"
    },
    "category": {
      "type": "string",
      "title": "Categor\u00eda",
      "enum": [
        "seguimiento",
        "visita",
        "oferta",
        "cierre",
        "documentacion",
        "otro"
      ],
      "enumColors": [
        "blue",
        "purple",
        "yellow",
        "green",
        "gray",
        "gray"
      ],
      "default": "seguimiento"
    },
    "subject": {
      "type": "string",
      "title": "Asunto"
    },
    "body": {
      "type": "string",
      "title": "Mensaje"
    },
    "active": {
      "type": "boolean",
      "title": "Activa",
      "default": true
    }
  },
  "required": [
    "name",
    "subject",
    "body"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    }
  }
}